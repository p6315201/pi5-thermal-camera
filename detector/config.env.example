# Налаштування запуску на Raspberry Pi (після змін: sudo systemctl restart thermal-viewer)
#
# Камера:  picam / picam0 / picam1 = CSI-камера Raspberry Pi
#          0, 1, 2 ...             = USB-камера (/dev/video0, /dev/video1 ...)
#          порожньо                = не підключена
# Номери камер: .venv/bin/python app.py --list-cameras
RGB=picam
THERMAL=0

# Інші параметри: розмір входу моделі, поріг, порт тощо (див. app.py --help)
ARGS="--ncnn --imgsz 416 --thermal-model sar_thermal.pt --port 8000"
