[Unit]
Description=RGB + thermal YOLO web viewer
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/config.env
ExecStart=__DIR__/.venv/bin/python __DIR__/app.py --rgb ${RGB} --thermal ${THERMAL} $ARGS
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
